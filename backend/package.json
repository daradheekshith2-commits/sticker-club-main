{
  "name": "sticker-club-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
