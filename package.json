{
  "name": "sticker-club-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-hero-sticker-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-hero-sticker-manifest.mjs && node scripts/check-art-paths.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "hero:manifest": "node scripts/generate-hero-sticker-manifest.mjs",
    "art:build": "node scripts/build-category-art.mjs",
    "art:check": "node scripts/check-art-paths.mjs",
    "images:optimize": "node scripts/optimize-catalogue-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "jszip": "^3.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.2.4",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
